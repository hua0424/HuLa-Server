<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>luohuo-im</artifactId>
        <groupId>com.luohuo.flex</groupId>
        <version>3.0.6</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>luohuo-im-controller</artifactId>
    <name>${project.artifactId}</name>
    <description>系统服务-控制层模块</description>

    <!-- ISS-013: 显式 hardening,见 luohuo-im/pom.xml -->
    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.luohuo.flex</groupId>
            <artifactId>luohuo-im-biz</artifactId>
            <version>${luohuo-project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.luohuo.flex</groupId>
            <artifactId>luohuo-login-user-resolver</artifactId>
            <version>${luohuo-project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.oshi</groupId>
            <artifactId>oshi-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.luohuo.flex</groupId>
            <artifactId>luohuo-im-cloud-impl</artifactId>
            <version>${luohuo-project.version}</version>
        </dependency>

        <!-- aichatoverview#26: controller 层 MockMvc 行为测试依赖。
             spring-boot-starter-test 提供 MockMvc + Mockito 5(原生 mockStatic,无需 mockito-inline)
             + JUnit Jupiter + JsonPath。与 luohuo-im-biz 测试栈一致。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- aichatoverview#26: 父 pom(luohuo-dependencies-parent)默认 skip=true 跳过测试;
                     本模块需运行 controller 层 MockMvc 行为测试,故覆盖为 false。与 luohuo-im-biz 一致。 -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <skipTests>false</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
